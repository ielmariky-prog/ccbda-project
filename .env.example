# proj1102 — example environment configuration
#
# Twelve-factor #3: all runtime config comes from the environment, never
# from code. Each component reads only the variables it needs.
#
# Local-dev usage:
#   cp .env.example .env
#   # fill in values
#   set -a; source .env; set +a   # POSIX shell auto-export
#
# CI / production: GitHub Actions uses repository secrets, not a checked-in
# .env. Lambdas store these as function-level environment variables, set by
# each component's deploy.sh — so the same code runs unchanged in dev or prod.

# ---------------------------------------------------------------------------
# AWS credentials / target account
# ---------------------------------------------------------------------------
AWS_PROFILE=<your-aws-profile>                # e.g. ralph, ralph-team
AWS_DEFAULT_REGION=eu-west-1
# Only needed if not using a named profile:
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>

# ---------------------------------------------------------------------------
# Shared data plane
# ---------------------------------------------------------------------------
TEAM=team01
DATA_BUCKET=proj1102-data                       # team account, cross-account writeable
ARTIFACT_BUCKET=proj1102-ralph-forecast-148557232117

# ---------------------------------------------------------------------------
# Tickers — keep in sync across config/, lambdas, sagemaker scripts
# ---------------------------------------------------------------------------
TICKERS=TSLA,MSFT,NVDA

# ---------------------------------------------------------------------------
# Alpha Vantage (Ilias's ingestion Lambda — his personal account)
# ---------------------------------------------------------------------------
# Each ticker gets three keys rotated by hour to stay inside the 25 req/day
# free-tier per-key limit. Keys 1-3 = TSLA, 4-6 = MSFT, 7-9 = NVDA.
APIKEY1=<key>
APIKEY2=<key>
APIKEY3=<key>
APIKEY4=<key>
APIKEY5=<key>
APIKEY6=<key>
APIKEY7=<key>
APIKEY8=<key>
APIKEY9=<key>

# Yahoo Finance is used by the daily ingest Lambda — public v8 chart API,
# no key required. Listed here only for documentation.
# YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# ---------------------------------------------------------------------------
# SQS queue URLs (team account, cross-account readable)
# ---------------------------------------------------------------------------
PRICESQUEUE=https://sqs.eu-west-1.amazonaws.com/834922934600/proj1102-prices-queue
NEWSQUEUE=https://sqs.eu-west-1.amazonaws.com/834922934600/proj1102-news-queue

# ---------------------------------------------------------------------------
# Forecast stack (Ralph's account 148557232117)
# ---------------------------------------------------------------------------
SAGEMAKER_ENDPOINT_HOURLY=proj1102-deepar-endpoint
SAGEMAKER_ENDPOINT_DAILY=proj1102-deepar-daily-endpoint
DDB_TABLE_HOURLY=proj1102-forecasts
DDB_TABLE_DAILY=proj1102-daily-forecasts

# Hyperparameters — change requires a retrain
CONTEXT_LENGTH_HOURLY=120                       # 10h of 5-min bars
PREDICTION_LENGTH_HOURLY=12                     # 1h ahead
CONTEXT_LENGTH_DAILY=60                         # ~12 trading weeks
PREDICTION_LENGTH_DAILY=7                       # 1 trading week ahead

# ---------------------------------------------------------------------------
# SNS topics
# ---------------------------------------------------------------------------
INFRA_ALARMS_TOPIC=arn:aws:sns:eu-west-1:148557232117:proj1102-infra-alarms
# Arthur's anomaly topic lives in his personal account:
ANOMALY_ALERTS_TOPIC=arn:aws:sns:eu-west-1:162655485124:proj1102-alerts

# ---------------------------------------------------------------------------
# Optional overrides (component deploy.sh scripts auto-detect when blank)
# ---------------------------------------------------------------------------
GLUE_ROLE_ARN=
LAMBDA_ROLE_ARN=
LOG_LEVEL=INFO
